# Copy to .env for local development. Never commit .env.
# Locally, leaving DATABASE_URL and SUPABASE_* empty gives you SQLite + files in ./media.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase → Project → Connect → "Session pooler" (port 5432).
# The "Direct connection" host is IPv6-only and will not work from Render.
DATABASE_URL=
# Only if you use the transaction pooler (port 6543) instead:
# DB_TRANSACTION_POOLER=true

# Supabase → Storage → create a PUBLIC bucket named "resources",
# then Storage → S3 Connection → create access keys.
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_REGION=eu-west-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# First admin account, created on deploy if missing (never overwritten).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Paystack → Settings → API Keys & Webhooks. Use sk_test_ until go-live.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://herwellafrica.com/payment/complete

# Mailchimp → Profile → Extras → API keys (looks like abc123-us21).
MAILCHIMP_API_KEY=

# Vercel → frontend project → Settings → Git → Deploy Hooks.
VERCEL_DEPLOY_HOOK_URL=
